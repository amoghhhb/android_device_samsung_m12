# Android fstab file for TWRP recovery on Samsung Galaxy M12 (SM-M127G)
# <mnt_point>      <type>  <src>                                                <flags>

/boot              emmc    /dev/block/by-name/boot                              flags=display="Boot";backup=1;flashimg=1
/recovery          emmc    /dev/block/by-name/recovery                          flags=display="Recovery";backup=1;flashimg=1
/cache             ext4    /dev/block/by-name/cache                             flags=display="Cache";wipeingui
/metadata          ext4    /dev/block/by-name/metadata                          flags=display="Metadata";wipeingui
/efs               ext4    /dev/block/by-name/sec_efs                           flags=display="EFS";backup=1
/sec_efs           ext4    /dev/block/by-name/efs                               flags=display="Sec EFS";backup=1
/data              f2fs    /dev/block/by-name/userdata                           flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption

# Dynamic Partitions
system             /system      ext4    ro    wait,logical,first_stage_mount
vendor             /vendor      ext4    ro    wait,logical,first_stage_mount
product            /product     ext4    ro    wait,logical,first_stage_mount
odm                /odm         ext4    ro    wait,logical,first_stage_mount

# Removable Storage
/external_sd       vfat    /dev/block/mmcblk1p1    /dev/block/mmcblk1          flags=display="MicroSD";storage;wipeingui;removable
/usb_otg           vfat    /dev/block/sda1         /dev/block/sda              flags=display="USB-OTG";storage;wipeingui;removable
